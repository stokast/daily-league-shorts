{
  "name": "spawn-ad",
  "version": "1.0.0",
  "description": "30 s vertical video ad for Spawn (spawn.co), rendered from code",
  "scripts": {
    "timeline": "node tools/timeline-json.mjs",
    "audio": "node tools/timeline-json.mjs && python3 audio/make_audio.py build/timeline.json build/audio.wav",
    "preview": "node render/render.mjs --w 540 --h 960 --jobs 2 --preset veryfast --crf 20 --out build/preview_540.mp4 --audio build/audio.wav",
    "render": "node render/render.mjs --jobs 2 --out build/spawn-ad-1080x1920.mp4 --audio build/audio.wav"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/nosifer": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@fontsource/sedgwick-ave-display": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/staatliches": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "@fontsource/zen-dots": "^5.3.0",
    "geist": "^1.9.2",
    "three": "^0.170.0"
  },
  "private": true
}